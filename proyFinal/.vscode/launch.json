{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Python: index.py",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/index.py",
      "console": "integratedTerminal",
      "justMyCode": true,
      "jinja": true,
      "exceptionOptions": [
        {
          "path": ["SystemExit"],
          "breakMode": "never"
        }
      ]
    }
  ]
}